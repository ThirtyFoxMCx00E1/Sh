{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shooting_star_demo:fx_ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/soft_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.0)"
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1.0 - 0.7 * (variable.particle_age / variable.particle_lifetime))",
          "variable.size * (1.0 - 0.7 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.r",
          "variable.g",
          "variable.b",
          "(variable.a > 0 ? variable.a : 1.0) * ((variable.hold > 0) ? 1.0 : ((1.0 - (variable.particle_age / variable.particle_lifetime)) * (1.0 - (variable.particle_age / variable.particle_lifetime))))"
        ]
      },
      "minecraft:emitter_shape_sphere": {
        "direction": "outwards",
        "radius": 0.05
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "variable.rise",
          0
        ],
        "linear_drag_coefficient": 0.6
      }
    }
  }
}
{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shooting_star_demo:fx_cloud",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/cloud_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.0)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size",
          "variable.size"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "variable.u",
            "variable.v"
          ],
          "uv_size": [
            "variable.uw",
            "variable.uh"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.r",
          "variable.g",
          "variable.b",
          "(variable.a > 0 ? variable.a : 1.0)"
        ]
      }
    }
  }
}
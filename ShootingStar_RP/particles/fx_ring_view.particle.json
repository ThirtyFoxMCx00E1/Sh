{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shooting_star_demo:fx_ring_view",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/ring"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.0)"
      },
      "minecraft:particle_initial_speed": "0",
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * ((variable.hold > 0) ? 1.0 : (0.12 + 0.88 * (1.0 - math.pow(1.0 - (variable.particle_age / variable.particle_lifetime), 3.0))))",
          "variable.size * ((variable.hold > 0) ? 1.0 : (0.12 + 0.88 * (1.0 - math.pow(1.0 - (variable.particle_age / variable.particle_lifetime), 3.0))))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.r",
          "variable.g",
          "variable.b",
          "(variable.a > 0 ? variable.a : 1.0) * ((variable.hold > 0) ? 1.0 : (1.0 - (variable.particle_age / variable.particle_lifetime)))"
        ]
      }
    }
  }
}
{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shooting_star_demo:fx_beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.0)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.w",
          "variable.h"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [16, 128]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.r",
          "variable.g",
          "variable.b",
          "(variable.a > 0 ? variable.a : 1.0) * ((variable.hold > 0) ? 1.0 : (1.0 - (variable.particle_age / variable.particle_lifetime)))"
        ]
      }
    }
  }
}

{
  "format_version": "1.8.0",
  "animations": {
    "animation.falling_star.spin": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            0,
            "query.anim_time * 720.0",
            "query.anim_time * 360.0"
          ]
        }
      }
    },
    "animation.falling_star.pulse": {
      "loop": true,
      "bones": {
        "core": {
          "scale": [
            "1.0 + math.sin(query.anim_time * 400.0) * 0.15",
            "1.0 + math.sin(query.anim_time * 400.0) * 0.15",
            "1.0 + math.sin(query.anim_time * 400.0) * 0.15"
          ]
        }
      }
    }
  }
}